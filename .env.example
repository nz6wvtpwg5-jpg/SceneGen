# Next.js application
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
DATABASE_URL=[REDACTED_DATABASE_URL]
AUTH_TRUST_HOST=true

# Server-only backend address. Do not prefix this with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:3001
BACKEND_SERVICE_TOKEN=

# Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public OAuth client identifiers embedded in the iOS web bundle.
# These are identifiers, not secrets.
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Server-side allow-list used when validating native Google ID tokens.
GOOGLE_IOS_CLIENT_ID=
# Native Sign in with Apple uses the iOS bundle identifier by default.
APPLE_IOS_CLIENT_ID=io.scenegen.app
NEXT_PUBLIC_APPLE_CLIENT_ID=io.scenegen.app
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=SceneGen <support@scenegen.io>
EMAIL_REPLY_TO=support@scenegen.io
APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Optional build-time override used by `pnpm ios:sync`.
# Keep this HTTPS and point it at SceneGen's native entry route.
SCENEGEN_NATIVE_SERVER_URL=https://scenegen-web.onrender.com/app
