{
  "name": "scenegenv2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:legacy && pnpm check:production && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:legacy": "node scripts/check-no-legacy-api-config.js",
    "check:production": "node scripts/check-production-surface.js",
    "openapi-ts": "openapi-ts",
    "ios:add": "cap add ios",
    "ios:check": "node scripts/check-ios-release.mjs && node --test backend/test/ios-capacitor-shell.test.js backend/test/offline-road-pack.test.js backend/test/native-push-notifications.test.js backend/test/release-readiness.test.js",
    "ios:prepare": "pnpm ios:check && pnpm ios:assets && pnpm ios:sync",
    "release:check": "pnpm ios:check && npm --prefix backend test && pnpm build",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "ios:assets": "capacitor-assets generate --ios"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.0.0",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@hey-api/client-fetch": "^0.8.1",
    "@icons-pack/react-simple-icons": "^12.0.0",
    "@nextui-org/react": "^2.6.11",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-google-maps/api": "^2.20.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.4.7",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.1.0",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.452.0",
    "luxon": "^3.5.0",
    "mammoth": "^1.12.2",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.3.0",
    "pdf-parse": "^2.4.5",
    "random-avatar-generator": "^2.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^2.1.0",
    "recharts": "^3.8.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@hey-api/openapi-ts": "^0.64.5",
    "@types/google.maps": "^3.58.1",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.17",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.17.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
